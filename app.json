{
  "expo": {
    "name": "lava-pizza",
    "slug": "lava-pizza",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lavapizza",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser"
      
    ],
"experiments": {
  "typedRoutes": true
},

    "extra": {
      "googleWebClientId": "898725473422-h5o07rea27deqfs5lhv05fitdk8qr38c.apps.googleusercontent.com"
    }
  }
}
